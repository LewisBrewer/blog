{%- set pageTitle = (title + " | " + site.title + " " + site.blogName) if title else (site.title + " | " + site.blogName) -%}
{%- set pageDescription = summary or description or site.description -%}
{%- set canonical = page.url | absolute -%}
{%- set ogImage = (cover.og if cover else "/assets/og-default.jpg") | absolute -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- if build.preview or draft or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <meta name="author" content="{{ site.author.name }}">
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">

  <meta property="og:site_name" content="{{ site.title }} {{ site.blogName }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
  <meta property="og:title" content="{{ title or site.blogName }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {%- if cover and cover.alt %}
  <meta property="og:image:alt" content="{{ cover.alt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {%- if isPost %}
  <meta property="article:published_time" content="{{ date | dateIso }}">
  {%- if dateModified %}<meta property="article:modified_time" content="{{ dateModified }}">{% endif %}
  <meta property="article:author" content="{{ site.author.url }}">
  {%- if series %}<meta property="article:section" content="{{ series }}">{% endif %}
  {%- for t in topics %}
  <meta property="article:tag" content="{{ t }}">
  {%- endfor %}
  <script type="application/ld+json">{{ { page: page, title: title, summary: summary, date: date, dateModified: dateModified, topics: topics, cover: cover, series: series, seriesSlug: seriesSlug, wordCount: wordCount } | postSchema | safe }}</script>
  {%- elif page.url == "/" %}
  <script type="application/ld+json">{{ "" | siteSchema | safe }}</script>
  {%- endif %}

  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}: {{ site.blogName }}" href="/feed.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/bn-romaine.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build.time | dateIso }}">
  {%- if site.cloudflareAnalyticsToken and not build.preview %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}<span class="brand-sub">{{ site.blogName }}</span></a>
    <nav class="site-nav" aria-label="Main">
      <a href="/series/">Series</a>
      <a href="/tags/">Tags</a>
      <a href="{{ site.portfolio.home }}">Portfolio</a>
    </nav>
  </header>
  {%- if build.preview %}
  <div class="preview-bar">Preview build. Not published. Drafts are included.</div>
  {%- endif %}
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <a class="back" href="{{ site.portfolio.home }}">Back to lewisbrewer.com</a>
    <div class="foot-meta">
      <a href="/feed.xml">RSS</a>
      {%- for s in site.author.sameAs %}{% if not loop.first %}
      <a href="{{ s }}" rel="me">{{ 'Instagram' if 'instagram' in s else ('LinkedIn' if 'linkedin' in s else s) }}</a>
      {%- endif %}{% endfor %}
      <span>© {{ "" | year }} {{ site.author.name }}</span>
    </div>
  </footer>
</body>
</html>
