---
permalink: /widget/latest/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Latest posts | {{ site.title }} {{ site.blogName }}</title>
  <base target="_blank">
  <style>
    @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url("/assets/fonts/inter-latin-wght-normal.woff2") format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
    @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url("/assets/fonts/inter-latin-ext-wght-normal.woff2") format("woff2"); unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
    :root { --fg: #f0f0f0; --muted: rgba(240,240,240,.63); --rule: rgba(240,240,240,.16); --accent: #ff5a5f; --img-bg: #111; }
    :root[data-theme="light"] { --fg: #111; --muted: rgba(17,17,17,.6); --rule: rgba(17,17,17,.15); --accent: #b51c22; --img-bg: #eee; }
    * { box-sizing: border-box; margin: 0; }
    html, body { background: transparent; color: var(--fg); font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    body { padding: 2px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 24px 20px; list-style: none; padding: 0; }
    .item a { display: block; color: inherit; text-decoration: none; }
    .media { aspect-ratio: 16 / 10; background: var(--img-bg); overflow: hidden; margin-bottom: 12px; }
    .media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
    .item a:hover img { transform: scale(1.03); }
    .date { font-size: 12px; line-height: 16px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
    .title { font-size: 18px; line-height: 1.15; font-weight: 500; letter-spacing: -0.02em; text-transform: uppercase; text-wrap: balance; }
    .item a:hover .title, .item a:focus-visible .title { color: var(--accent); }
    .all { display: inline-block; margin-top: 20px; font-size: 13px; letter-spacing: .02em; text-transform: uppercase; color: var(--fg); text-decoration: underline; text-decoration-color: #d12229; text-underline-offset: 4px; }
    .empty { color: var(--muted); font-size: 14px; }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { .media img { transition: none; } }
  </style>
</head>
<body>
  <ul class="grid" id="posts">
    {%- for post in collections.posts | limit(12) %}{% if not post.data.draft %}
    <li class="item" data-series="{{ post.data.seriesSlug or '' }}">
      <a href="{{ post.url | absolute }}">
        <div class="media">{% if post.data.cover %}<img src="{{ post.data.cover.thumb | absolute }}" alt="" width="640" height="400" loading="lazy" decoding="async">{% endif %}</div>
        <p class="date"><time datetime="{{ post.date | dateIso }}">{{ post.date | dateLong }}</time></p>
        <p class="title">{{ post.data.title }}</p>
      </a>
    </li>
    {%- endif %}{% endfor %}
  </ul>
  <p class="empty" id="empty" hidden>The first post is on its way.</p>
  <a class="all" id="all" href="{{ '/' | absolute }}">All posts</a>
  <script>
    (function () {
      var q = new URLSearchParams(location.search);
      var n = Math.max(1, Math.min(12, parseInt(q.get('n') || '3', 10) || 3));
      var series = q.get('series');
      if (q.get('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light');
      var items = [].slice.call(document.querySelectorAll('.item'));
      var shown = 0;
      items.forEach(function (li) {
        var ok = (!series || li.getAttribute('data-series') === series) && shown < n;
        if (ok) shown++; else li.remove();
      });
      if (!shown) { document.getElementById('empty').hidden = false; }
      if (series && shown) document.getElementById('all').href = '{{ "/series/" | absolute }}' + encodeURIComponent(series) + '/';
      if (q.get('all') === '0') document.getElementById('all').remove();
      // Tell the page that embeds us how tall we are.
      function send() { parent.postMessage({ type: 'lb-blog-widget', height: Math.ceil(document.documentElement.scrollHeight) }, '*'); }
      if ('ResizeObserver' in window) new ResizeObserver(send).observe(document.body);
      window.addEventListener('load', send);
      send();
    })();
  </script>
</body>
</html>
